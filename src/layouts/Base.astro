---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '记录与思考的角落' } = Astro.props;
const fullTitle = title === '首页' ? 'MUYI BLOG' : `${title} · MUYI BLOG`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="MUYI BLOG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title="MUYI BLOG" href="/rss.xml" />
    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "8e99161d9ccb4519881bbf20c6a2acd0"}'></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="image/png" href="/og-default.png" />
    <meta property="og:image" content="https://hallowmuyi.space/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hallowmuyi.space/og-default.png" />
    <meta name="theme-color" content="#f2efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1c2c" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b-2 border-border dark:border-border-dark">
      <nav class="max-w-2xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
        <a href="/" class="font-pixel text-2xl leading-none tracking-widest shrink-0 flex items-center">MUYI<span class="inline-block w-2 h-2 ml-1.5 bg-accent dark:bg-accent-dark"></span></a>
        <div class="flex items-center gap-1 sm:gap-2">
          <a href="/blog" class="px-nav-link">文章</a>
          <a href="/archive" class="px-nav-link">归档</a>
          <a href="/tags" class="px-nav-link">标签</a>
          <a href="/games" class="px-nav-link">游戏书架</a>
          <a href="/about" class="px-nav-link">关于</a>
          <a id="admin-link" href="/admin" class="hidden px-nav-link !text-accent dark:!text-accent-dark">后台</a>
          <a id="edit-link" href="/admin" class="hidden px-nav-link !text-accent dark:!text-accent-dark">编辑</a>
          <button
            id="search-toggle"
            aria-label="搜索"
            class="text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark cursor-pointer ml-1"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges">
              <rect x="2" y="2" width="14" height="2" />
              <rect x="2" y="2" width="2" height="14" />
              <rect x="14" y="2" width="2" height="14" />
              <rect x="2" y="14" width="14" height="2" />
              <rect x="16" y="16" width="2" height="2" />
              <rect x="18" y="18" width="2" height="2" />
              <rect x="20" y="20" width="2" height="2" />
            </svg>
          </button>
          <button
            id="theme-toggle"
            aria-label="切换主题"
            class="text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark cursor-pointer"
          >
            <svg id="icon-sun" class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges">
              <rect x="7" y="7" width="10" height="10" />
              <rect x="11" y="2" width="2" height="4" />
              <rect x="11" y="18" width="2" height="4" />
              <rect x="2" y="11" width="4" height="2" />
              <rect x="18" y="11" width="4" height="2" />
            </svg>
            <svg id="icon-moon" class="w-5 h-5 block dark:hidden" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges">
              <rect x="14" y="2" width="6" height="2" />
              <rect x="12" y="4" width="6" height="2" />
              <rect x="10" y="6" width="6" height="2" />
              <rect x="8" y="8" width="6" height="2" />
              <rect x="6" y="10" width="6" height="2" />
              <rect x="6" y="12" width="6" height="2" />
              <rect x="6" y="14" width="6" height="2" />
              <rect x="8" y="16" width="6" height="2" />
              <rect x="10" y="18" width="6" height="2" />
              <rect x="12" y="20" width="6" height="2" />
            </svg>
          </button>
        </div>
      </nav>
      <div id="search-panel" class="hidden border-t-2 border-border dark:border-border-dark">
        <div class="max-w-2xl mx-auto px-6 py-3">
          <input
            id="search-input"
            type="search"
            placeholder="搜索文章…"
            autocomplete="off"
            class="w-full bg-panel dark:bg-panel-dark border-2 border-border dark:border-border-dark outline-none text-base px-3 py-1.5 placeholder:text-muted dark:placeholder:text-muted-dark focus:border-accent dark:focus:border-accent-dark"
          />
          <ul id="search-results" class="mt-2 space-y-1"></ul>
        </div>
      </div>
    </header>

    <main class="flex-1 w-full max-w-2xl mx-auto px-4 sm:px-6 py-12">
      <slot />
    </main>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // 站内模糊搜索
      (function () {
        var panel = document.getElementById('search-panel');
        var input = document.getElementById('search-input');
        var results = document.getElementById('search-results');
        var index = null;

        function toggle() {
          var opening = panel.classList.contains('hidden');
          panel.classList.toggle('hidden');
          if (opening) {
            input.focus();
            if (!index) {
              fetch('/search-index.json')
                .then(function (r) { return r.json(); })
                .then(function (d) { index = d; render(); });
            }
          }
        }

        // 子序列模糊匹配，返回匹配度（越大越好），不匹配返回 -1
        function fuzzy(query, text) {
          var qi = 0, score = 0, lastHit = -2;
          for (var ti = 0; ti < text.length && qi < query.length; ti++) {
            if (text[ti] === query[qi]) {
              score += ti === lastHit + 1 ? 3 : 1; // 连续命中加权
              lastHit = ti;
              qi++;
            }
          }
          return qi === query.length ? score : -1;
        }

        function render() {
          var q = input.value.trim().toLowerCase();
          results.innerHTML = '';
          if (!q || !index) return;
          var hits = [];
          for (var i = 0; i < index.length; i++) {
            var p = index[i];
            var best = Math.max(
              fuzzy(q, p.title.toLowerCase()) + 100,
              fuzzy(q, (p.tags || []).join(' ').toLowerCase()) + 50,
              fuzzy(q, (p.description || '').toLowerCase()) + 20,
              fuzzy(q, (p.body || '').toLowerCase())
            );
            if (best >= 0) hits.push({ p: p, s: best });
          }
          hits.sort(function (a, b) { return b.s - a.s; });
          hits.slice(0, 8).forEach(function (h) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = '/blog/' + h.p.slug;
            a.className = 'flex items-baseline justify-between gap-4 px-2 py-2 hover:bg-accent hover:text-panel dark:hover:bg-accent-dark dark:hover:text-bg-dark';
            var t = document.createElement('span');
            t.textContent = h.p.title;
            var d = document.createElement('time');
            d.className = 'font-pixel text-xs text-muted dark:text-muted-dark shrink-0';
            d.textContent = h.p.date;
            a.appendChild(t);
            a.appendChild(d);
            li.appendChild(a);
            results.appendChild(li);
          });
          if (!hits.length) {
            var li = document.createElement('li');
            li.className = 'py-2 text-muted dark:text-muted-dark text-sm';
            li.textContent = '没有匹配的文章';
            results.appendChild(li);
          }
        }

        document.getElementById('search-toggle').addEventListener('click', toggle);
        input.addEventListener('input', render);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
            panel.classList.add('hidden');
          }
        });
      })();

      // 已登录管理员：显示「后台」入口，文章页额外显示「编辑本文」
      if (!location.pathname.startsWith('/admin')) {
        fetch('/api/session')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d.authed) return;
            document.getElementById('admin-link').classList.remove('hidden');
            var m = location.pathname.match(/^\/blog\/([^/]+)\/?$/);
            if (m) {
              var a = document.getElementById('edit-link');
              a.href = '/admin?edit=' + m[1];
              a.classList.remove('hidden');
            }
          })
          .catch(function () {});
      }
    </script>
  </body>
</html>
