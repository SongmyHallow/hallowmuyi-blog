---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);

const tagCount = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="标签">
  <h1 class="font-pixel text-2xl mb-2">标签</h1>
  <p class="font-pixel text-xs text-muted dark:text-muted-dark mb-10">TAGS {tags.length}</p>
  {tags.length === 0 ? (
    <p class="text-muted dark:text-muted-dark">还没有标签。</p>
  ) : (
    <ul class="flex flex-wrap gap-3">
      {tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}`} class="px-tag inline-flex items-center gap-2 !py-1">
            <span>#{tag}</span>
            <span class="opacity-60">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
