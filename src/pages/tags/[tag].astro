---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { listPosts } from '../../lib/db';

const tag = Astro.params.tag ?? '';
const posts = (await listPosts()).filter((post) => post.tags.includes(tag));

if (posts.length === 0) {
  const notFound = await Astro.rewrite('/404');
  return new Response(notFound.body, { status: 404, headers: notFound.headers });
}
---

<Base title={`#${tag}`}>
  <h1 class="font-pixel text-2xl mb-2">#{tag}</h1>
  <p class="font-pixel text-xs text-muted dark:text-muted-dark mb-8">{posts.length} 篇文章</p>
  <div class="space-y-6">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Base>
