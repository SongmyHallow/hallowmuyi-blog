---
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/db';
import { renderMarkdown } from '../lib/markdown';

const page = await getPage('about');

if (!page) {
  const notFound = await Astro.rewrite('/404');
  return new Response(notFound.body, { status: 404, headers: notFound.headers });
}

const html = renderMarkdown(page.body);
---

<Base title="关于">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px] xl:gap-16">
    <article class="min-w-0 max-w-[46rem]">
      <header class="mb-10 border-b-2 border-dashed border-shadow pb-6 dark:border-border-dark">
        <p class="font-pixel text-xs text-muted dark:text-muted-dark">CREDITS</p>
        <h1 class="mt-3 font-pixel text-3xl leading-tight sm:text-4xl lg:text-[42px]">关于</h1>
      </header>
      <div class="prose-blog" set:html={html} />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-5">
        <section class="px-card p-4">
          <h2 class="mb-3 font-pixel text-xs text-muted dark:text-muted-dark">本站</h2>
          <p class="text-sm leading-relaxed text-muted dark:text-muted-dark">
            一个像素游戏风的个人博客，记录技术、阅读和一些没头没脑的念头。
          </p>
        </section>
        <nav class="px-card p-4" aria-label="站外链接">
          <h2 class="mb-3 font-pixel text-xs text-muted dark:text-muted-dark">LINKS</h2>
          <ul class="space-y-2 text-sm">
            <li><a class="transition-colors hover:text-accent dark:hover:text-accent-dark" href="/rss.xml">▸ RSS 订阅</a></li>
            <li><a class="transition-colors hover:text-accent dark:hover:text-accent-dark" href="/sitemap.xml">▸ 站点地图</a></li>
            <li>
              <a
                class="transition-colors hover:text-accent dark:hover:text-accent-dark"
                href="https://github.com/SongmyHallow/hallowmuyi-blog"
                rel="me noopener"
                target="_blank"
              >▸ GitHub ↗</a>
            </li>
          </ul>
        </nav>
      </div>
    </aside>
  </div>
</Base>
