---
import Base from '../../layouts/Base.astro';
import { getGame, listPosts } from '../../lib/db';
import { formatGameDate } from '../../utils/gameMeta';
import { formatDate } from '../../utils/postMeta';

const game = await getGame(Astro.params.slug ?? '');

if (!game || game.draft) {
  const notFound = await Astro.rewrite('/404');
  return new Response(notFound.body, { status: 404, headers: notFound.headers });
}

// 关联博客：过滤草稿，无效 slug 跳过
const postsBySlug = new Map((await listPosts()).map((post) => [post.slug, post]));
const relatedPosts = game.relatedPosts
  .map((slug) => postsBySlug.get(slug))
  .filter((post) => Boolean(post));

// 时间线按日期倒序
const timeline = [...game.timeline].sort((a, b) => (a.date < b.date ? 1 : -1));

// 基本信息：空值不显示
const facts: { label: string; value: string }[] = [];
if (game.developer) facts.push({ label: '开发商', value: game.developer });
if (game.publisher) facts.push({ label: '发行商', value: game.publisher });
if (game.releaseDate) facts.push({ label: '发售日期', value: formatGameDate(game.releaseDate) });
if (game.platforms.length) facts.push({ label: '平台', value: game.platforms.join(' / ') });
if (game.genres.length) facts.push({ label: '类型', value: game.genres.join(' / ') });

const sectionTitle =
  'mb-3 inline-block border-2 border-shadow bg-tint px-2 py-[3px] font-pixel text-xs tracking-[0.14em] dark:border-border-dark dark:bg-tint-dark';
---

<Base title={game.title} description={game.summary}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <a href="/games" class="px-btn">← 返回书架</a>
    <a
      id="game-edit-link"
      href={`/admin?game=${game.slug}`}
      class="hidden px-btn !text-accent dark:!text-accent-dark">编辑此游戏</a
    >
  </div>

  <div class="grid items-start gap-7 sm:grid-cols-[240px_1fr] sm:gap-8 lg:grid-cols-[300px_1fr] lg:gap-12">
    <div class="mx-auto w-full max-w-[240px] sm:mx-0 sm:max-w-none">
      <div class="px-card overflow-hidden">
        <img
          src={game.cover}
          alt={`${game.title} 封面`}
          decoding="async"
          class="block aspect-[3/4] w-full object-cover"
        />
      </div>
    </div>

    <div>
      <h1 class="font-pixel text-3xl leading-tight lg:text-[44px]">{game.title}</h1>
      {game.originalTitle && (
        <p class="mt-2 font-pixel text-xs text-muted dark:text-muted-dark">{game.originalTitle}</p>
      )}
      {game.summary && (
        <p class="mt-5 max-w-[58ch] leading-relaxed text-muted dark:text-muted-dark">{game.summary}</p>
      )}

      {facts.length > 0 && (
        <dl class="mt-6 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
          {facts.map((fact) => (
            <div class="flex gap-3">
              <dt class="w-16 shrink-0 font-pixel text-xs text-muted dark:text-muted-dark">{fact.label}</dt>
              <dd class="leading-relaxed">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {game.officialUrl && (
        <a href={game.officialUrl} target="_blank" rel="noopener noreferrer" class="px-btn mt-6">
          官方网站 →
        </a>
      )}
    </div>
  </div>

  <div class="mt-12 grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
    {game.scores.length > 0 && (
      <section class="lg:col-span-5">
        <h2 class={sectionTitle}>评分</h2>
        <div class="flex flex-wrap gap-2">
          {game.scores.map((score) => (
            <span class="inline-flex items-baseline gap-2 border-2 border-border bg-panel px-3 py-1.5 dark:border-border-dark dark:bg-panel-dark">
              <span class="font-pixel text-xs text-muted dark:text-muted-dark">{score.source}</span>
              <span class="font-pixel text-lg text-accent dark:text-accent-dark">{score.score}</span>
            </span>
          ))}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="lg:col-span-7">
        <h2 class={sectionTitle}>关联博客</h2>
        <ul>
          {relatedPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}/`}
                class="group flex items-baseline justify-between gap-4 border-b border-dashed border-shadow py-2 dark:border-border-dark"
              >
                <span class="leading-snug group-hover:text-accent dark:group-hover:text-accent-dark">
                  {post.title}
                </span>
                <time class="shrink-0 font-pixel text-xs text-muted dark:text-muted-dark">
                  [{formatDate(post.date)}]
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {game.links.length > 0 && (
      <section class="lg:col-span-12">
        <h2 class={sectionTitle}>外部链接存档</h2>
        <ul class="grid gap-x-10 lg:grid-cols-2">
          {game.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-wrap items-baseline gap-x-2 gap-y-1 border-b border-dashed border-shadow py-2 hover:text-accent dark:border-border-dark dark:hover:text-accent-dark"
              >
                <span class="px-tag">{link.type === 'video' ? '视频' : '文章'}</span>
                <span class="leading-snug">{link.title}</span>
                {link.note && <span class="text-sm text-muted dark:text-muted-dark">{link.note}</span>}
                {link.date && (
                  <time class="ml-auto shrink-0 font-pixel text-xs text-muted dark:text-muted-dark">
                    {formatGameDate(link.date)}
                  </time>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {timeline.length > 0 && (
      <section class="lg:col-span-12">
        <h2 class={sectionTitle}>版本时间线</h2>
        <ol class="ml-1.5 border-l-2 border-shadow dark:border-border-dark">
          {timeline.map((item) => (
            <li class="relative py-3 pl-6">
              <span class="absolute -left-[7px] top-5 h-3 w-3 bg-accent dark:bg-accent-dark"></span>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-pixel text-sm">{item.version}</span>
                <time class="font-pixel text-xs text-muted dark:text-muted-dark">
                  {formatGameDate(item.date)}
                </time>
              </div>
              <p class="mt-1 max-w-[60ch] text-sm leading-relaxed">{item.summary}</p>
              {item.url && (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm text-link underline decoration-dotted underline-offset-4 hover:no-underline dark:text-link-dark">
                  更新日志 →
                </a>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</Base>

<script is:inline>
  // 已登录管理员：显示「编辑此游戏」入口
  fetch('/api/session')
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d.authed) return;
      var link = document.getElementById('game-edit-link');
      if (link) link.classList.remove('hidden');
    })
    .catch(function () {});
</script>
