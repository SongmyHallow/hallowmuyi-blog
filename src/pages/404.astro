---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="页面不存在">
  <section class="px-card p-8 text-center">
    <p class="font-pixel text-6xl text-accent dark:text-accent-dark">404</p>
    <h1 class="font-pixel text-2xl mt-4">GAME OVER</h1>
    <p class="text-muted dark:text-muted-dark mt-2 leading-relaxed">
      这一关不存在，可能链接走错了。<br />
      回到标题画面重新开始吧。
    </p>
    <a href="/" class="px-btn mt-6">PRESS START →</a>
  </section>
</Base>
