---
import Base from '../../layouts/Base.astro';
import Giscus from '../../components/Giscus.astro';
import { getNeighborPosts, getPost } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';
import { postMeta, formatDate } from '../../utils/postMeta';

const slug = Astro.params.slug ?? '';
const post = slug ? await getPost(slug) : null;

if (!post || post.draft) {
  const notFound = await Astro.rewrite('/404');
  return new Response(notFound.body, { status: 404, headers: notFound.headers });
}

const { newer, older } = await getNeighborPosts(post.slug, post.date);
const html = renderMarkdown(post.body);
const { words, minutes } = postMeta(post.body);
---

<Base title={post.title} description={post.description}>
  <article>
    <header class="mb-10">
      <h1 class="font-pixel text-4xl leading-tight mb-4">{post.title}</h1>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-pixel text-xs text-muted dark:text-muted-dark">
        <time>[{formatDate(post.date)}]</time>
        <span class="opacity-50">·</span>
        <span>{words} 字 · 约 {minutes} 分钟</span>
        {post.tags.map((t) => (
          <a href={`/tags/${t}`} class="px-tag">#{t}</a>
        ))}
      </div>
    </header>
    <div class="prose-blog" set:html={html} />
    <nav class="mt-16 grid sm:grid-cols-2 gap-4">
      {older ? (
        <a href={`/blog/${older.slug}`} class="px-card p-4 hover:border-accent dark:hover:border-accent-dark">
          <span class="font-pixel text-xs text-muted dark:text-muted-dark">← 上一篇</span>
          <span class="block mt-2 leading-snug">{older.title}</span>
        </a>
      ) : <span />}
      {newer ? (
        <a href={`/blog/${newer.slug}`} class="px-card p-4 sm:text-right hover:border-accent dark:hover:border-accent-dark">
          <span class="font-pixel text-xs text-muted dark:text-muted-dark">下一篇 →</span>
          <span class="block mt-2 leading-snug">{newer.title}</span>
        </a>
      ) : <span />}
    </nav>
    <Giscus />
  </article>
</Base>
