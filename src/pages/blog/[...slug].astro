---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="mb-10">
      <h1 class="font-serif text-3xl font-semibold leading-snug mb-3">{post.data.title}</h1>
      <div class="flex items-center gap-3 text-sm text-muted dark:text-muted-dark">
        <time class="font-mono">{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && (
          <span class="flex gap-2">
            {post.data.tags.map((t) => <span>#{t}</span>)}
          </span>
        )}
      </div>
    </header>
    <div class="prose-blog">
      <Content />
    </div>
  </article>
</Base>
