---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { listPosts } from '../../lib/db';

const posts = await listPosts();
---

<Base title="文章">
  <h1 class="font-pixel text-2xl mb-2">SELECT SAVE</h1>
  <p class="font-pixel text-xs text-muted dark:text-muted-dark mb-8">TOTAL {posts.length}</p>
  <div class="space-y-6">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Base>
