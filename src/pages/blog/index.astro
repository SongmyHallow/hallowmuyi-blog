---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { listPosts } from '../../lib/db';

const posts = await listPosts();
---

<Base title="文章">
  <header class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b-2 border-dashed border-shadow pb-4 dark:border-border-dark">
    <div>
      <h1 class="font-pixel text-2xl lg:text-3xl">SELECT SAVE</h1>
      <p class="mt-2 font-pixel text-xs text-muted dark:text-muted-dark">TOTAL {posts.length}</p>
    </div>
    <a href="/archive" class="px-btn">按年份归档 →</a>
  </header>

  {posts.length > 0 ? (
    <div class={`grid items-start gap-6 ${posts.length > 1 ? 'lg:grid-cols-2 lg:gap-7' : ''}`}>
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <section class="px-card p-10 text-center">
      <p class="font-pixel text-2xl text-accent dark:text-accent-dark">NO SAVES</p>
      <p class="mt-3 text-muted dark:text-muted-dark">还没有文章，先写下第一篇吧。</p>
    </section>
  )}
</Base>
