---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/postMeta';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="归档">
  <h1 class="text-2xl font-bold mb-10">归档</h1>
  {years.map((year) => (
    <section class="mb-10">
      <h2 class="text-sm font-mono text-muted dark:text-muted-dark tracking-widest mb-4">{year}</h2>
      <ul class="space-y-2.5">
        {byYear.get(year)!.map((post) => (
          <li class="group flex items-baseline gap-4">
            <time class="text-sm text-muted dark:text-muted-dark font-mono shrink-0 w-24">
              {formatDate(post.data.date)}
            </time>
            <a href={`/blog/${post.id}`} class="group-hover:text-accent dark:group-hover:text-accent-dark transition-colors leading-snug">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
