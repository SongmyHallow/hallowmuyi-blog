---
import Base from '../layouts/Base.astro';
import { listPosts } from '../lib/db';
import { formatDate, yearOf } from '../utils/postMeta';

const posts = await listPosts();

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = yearOf(post.date);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="归档">
  <h1 class="font-pixel text-2xl mb-2">归档</h1>
  <p class="font-pixel text-xs text-muted dark:text-muted-dark mb-10">ARCHIVE</p>
  {years.map((year) => (
    <section class="mb-10">
      <h2 class="font-pixel text-2xl mb-4 pb-2 border-b-2 border-dashed border-shadow dark:border-border-dark">
        <span class="text-accent dark:text-accent-dark">▸</span> {year}
      </h2>
      <ul class="space-y-2">
        {byYear.get(year)!.map((post) => (
          <li class="flex items-baseline gap-3">
            <time class="font-pixel text-xs text-muted dark:text-muted-dark shrink-0 w-24">
              [{formatDate(post.date)}]
            </time>
            <a href={`/blog/${post.slug}`} class="leading-snug hover:bg-accent hover:text-panel dark:hover:bg-accent-dark dark:hover:text-bg-dark px-1">
              {post.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
