---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);
---

<Base title="首页">
  <section class="mb-16 mt-4">
    <h1 class="text-3xl font-bold mb-4">muyi</h1>
    <p class="text-muted dark:text-muted-dark leading-relaxed">
      写下来，是为了看清自己在想什么。
    </p>
  </section>

  <section>
    <h2 class="text-sm font-mono text-muted dark:text-muted-dark uppercase tracking-widest mb-6">最新文章</h2>
    <div class="space-y-7">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <a href="/blog" class="inline-block mt-10 text-sm text-accent dark:text-accent-dark hover:underline underline-offset-4">
      全部文章 →
    </a>
  </section>
</Base>
