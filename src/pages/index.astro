---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);
---

<Base title="首页">
  <section class="px-card p-5 sm:p-6 mb-14">
    <div class="flex items-center justify-between font-pixel text-xs text-muted dark:text-muted-dark mb-4">
      <span>PLAYER 1</span>
      <span>LV.01</span>
    </div>
    <h1 class="font-pixel text-4xl leading-none tracking-widest mb-4 flex items-center">
      MUYI<span class="inline-block w-3 h-3 ml-2 bg-accent dark:bg-accent-dark"></span>
    </h1>
    <p class="text-muted dark:text-muted-dark leading-relaxed">
      写下来，是为了看清自己在想什么。
    </p>
    <div class="mt-5 pt-4 border-t-2 border-dashed border-shadow dark:border-border-dark flex items-center gap-3 font-pixel text-xs text-muted dark:text-muted-dark">
      <span>STATUS</span>
      <span class="tracking-[0.25em] text-accent dark:text-accent-dark">▮▮▮▮</span>
      <span class="tracking-[0.25em] opacity-25">▮</span>
      <span class="ml-auto">ONLINE</span>
    </div>
  </section>

  <section>
    <h2 class="font-pixel text-xs tracking-[0.2em] text-muted dark:text-muted-dark mb-6">
      <span class="text-accent dark:text-accent-dark">▸</span> 最新文章
    </h2>
    <div class="space-y-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <a href="/blog" class="px-btn mt-10">全部文章 →</a>
  </section>
</Base>
