---
import Base from '../layouts/Base.astro';
import { listGames, listPosts } from '../lib/db';
import { sortGames } from '../utils/gameMeta';
import { formatDate, postMeta } from '../utils/postMeta';

const posts = await listPosts();

// 标签按文章数倒序，供左侧筛选面板使用
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN')
);

// 近期游戏：书架里的非草稿游戏，按最近更新排前四个
const allGames = (await listGames()).filter((game) => !game.draft);
const recentGames = sortGames(allGames, 'updated').slice(0, 4);
---

<Base title="首页">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[264px_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[288px_minmax(0,1fr)]">
    {/* 左侧栏：个人简介 / 标签筛选 / 近期游戏 */}
    <aside class="min-w-0 space-y-5 lg:sticky lg:top-24">
      <section class="px-card p-5">
        <div class="flex items-center gap-3.5">
          <svg
            viewBox="0 0 16 16"
            shape-rendering="crispEdges"
            class="h-14 w-14 shrink-0 border-2 border-border dark:border-border-dark"
            aria-hidden="true"
          >
            <!-- 像素头像占位：想换成自己的图，直接改用 <img src="/avatar.png" alt="muyi" /> 即可 -->
            <rect width="16" height="16" fill="#f2efe6"></rect>
            <g fill="#2b2622">
              <rect x="4" y="2" width="8" height="1"></rect>
              <rect x="3" y="3" width="10" height="1"></rect>
              <rect x="3" y="4" width="1" height="5"></rect>
              <rect x="12" y="4" width="1" height="5"></rect>
              <rect x="5" y="4" width="6" height="1"></rect>
            </g>
            <rect x="5" y="5" width="6" height="4" fill="#f3c9a1"></rect>
            <rect x="7" y="9" width="2" height="1" fill="#f3c9a1"></rect>
            <g fill="#2b2622">
              <rect x="6" y="6" width="1" height="1"></rect>
              <rect x="9" y="6" width="1" height="1"></rect>
              <rect x="7" y="8" width="2" height="1"></rect>
            </g>
            <rect x="4" y="10" width="8" height="1" fill="#c1553b"></rect>
            <rect x="3" y="11" width="10" height="5" fill="#c1553b"></rect>
            <rect x="7" y="10" width="2" height="1" fill="#f3c9a1"></rect>
          </svg>
          <div class="min-w-0">
            <p class="font-pixel text-lg leading-none">muyi</p>
            <p class="mt-2 text-xs leading-relaxed text-muted dark:text-muted-dark">
              写代码 · 读书 · 胡思乱想
            </p>
          </div>
        </div>
        <dl class="mt-4 grid grid-cols-3 gap-2 border-t-2 border-dashed border-shadow pt-3 text-center dark:border-border-dark">
          <div>
            <dt class="font-pixel text-[10px] text-muted dark:text-muted-dark">文章</dt>
            <dd class="mt-1 font-pixel text-sm">{posts.length}</dd>
          </div>
          <div>
            <dt class="font-pixel text-[10px] text-muted dark:text-muted-dark">游戏</dt>
            <dd class="mt-1 font-pixel text-sm">{allGames.length}</dd>
          </div>
          <div>
            <dt class="font-pixel text-[10px] text-muted dark:text-muted-dark">标签</dt>
            <dd class="mt-1 font-pixel text-sm">{tags.length}</dd>
          </div>
        </dl>
      </section>

      <section class="px-card p-5">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h2 class="font-pixel text-xs text-muted dark:text-muted-dark">标签筛选</h2>
          <div class="flex items-center gap-3 font-pixel text-[11px]">
            <button
              id="tag-clear"
              type="button"
              class="hidden text-muted transition-colors hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark"
            >清空</button>
            <a
              href="/tags"
              class="text-muted transition-colors hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark"
            >全部 →</a>
          </div>
        </div>
        {tags.length > 0 ? (
          <div class="flex flex-wrap gap-2">
            {tags.map(([tag, count]) => (
              <label class="tag-filter px-tag" data-tag={tag}>
                <input type="checkbox" value={tag} />
                <span>#{tag}</span>
                <span class="tag-count">{count}</span>
              </label>
            ))}
          </div>
        ) : (
          <p class="text-xs text-muted dark:text-muted-dark">还没有标签。</p>
        )}
      </section>

      <section class="px-card p-5">
        <div class="mb-3 flex items-baseline justify-between gap-3">
          <h2 class="font-pixel text-xs text-muted dark:text-muted-dark">近期游戏</h2>
          <a
            href="/games"
            class="font-pixel text-[11px] text-muted transition-colors hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark"
          >书架 →</a>
        </div>
        {recentGames.length > 0 ? (
          <ul class="grid grid-cols-4 gap-2 lg:grid-cols-2 lg:gap-3">
            {recentGames.map((game) => (
              <li>
                <a href={`/games/${game.slug}`} class="group block">
                  <img
                    src={game.cover}
                    alt={game.title}
                    width="600"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[3/4] w-full border-2 border-border object-cover transition-colors group-hover:border-accent dark:border-border-dark dark:group-hover:border-accent-dark"
                    onerror="this.style.display='none'"
                  />
                  <span class="mt-1.5 block truncate text-xs text-muted dark:text-muted-dark">{game.title}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs text-muted dark:text-muted-dark">还没有记录，去后台加一个。</p>
        )}
      </section>
    </aside>

    {/* 右侧：全部文章瀑布流 */}
    <section class="min-w-0">
      <div class="mb-5 flex items-end justify-between gap-4 border-b-2 border-dashed border-shadow pb-3 dark:border-border-dark">
        <div>
          <h1 class="font-pixel text-2xl leading-none">文章</h1>
          <p id="post-count" class="mt-2 font-pixel text-xs text-muted dark:text-muted-dark">{posts.length} 篇</p>
        </div>
        <a href="/archive" class="px-btn shrink-0">按年份归档 →</a>
      </div>

      <div id="post-grid" class="columns-1 gap-5 sm:columns-2 2xl:columns-3">
        {posts.map((post) => {
          const meta = postMeta(post.body);
          return (
            <article class="post-card mb-5 break-inside-avoid px-card p-5" data-tags={post.tags.join(' ')}>
              <div class="flex items-center justify-between font-pixel text-[11px] text-muted dark:text-muted-dark">
                <span>[{formatDate(post.date)}]</span>
                <span>{meta.minutes} 分钟</span>
              </div>
              <h2 class="mt-2 text-lg font-bold leading-snug">
                <a
                  href={`/blog/${post.slug}`}
                  class="transition-colors hover:text-accent dark:hover:text-accent-dark"
                >{post.title}</a>
              </h2>
              {post.description && (
                <p class="mt-2 text-sm leading-relaxed text-muted dark:text-muted-dark">{post.description}</p>
              )}
              {post.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {post.tags.map((tag) => (
                    <a href={`/tags/${tag}`} class="px-tag text-[11px]">#{tag}</a>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>

      <p
        id="post-empty"
        hidden
        class="px-card p-8 text-center text-sm text-muted dark:text-muted-dark"
      >没有匹配的文章，换个标签试试。</p>
    </section>
  </div>

  <script>
    const boxes = Array.from(document.querySelectorAll('.tag-filter input')) as HTMLInputElement[];
    const cards = Array.from(document.querySelectorAll('.post-card')) as HTMLElement[];
    const countEl = document.getElementById('post-count');
    const emptyEl = document.getElementById('post-empty');
    const clearBtn = document.getElementById('tag-clear');

    function applyFilter() {
      const selected = boxes.filter((box) => box.checked).map((box) => box.value);
      let visible = 0;
      for (const card of cards) {
        const cardTags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
        const matched = selected.length === 0 || selected.some((tag) => cardTags.includes(tag));
        card.hidden = !matched;
        if (matched) visible += 1;
      }
      if (countEl) {
        countEl.textContent = selected.length > 0 ? `${visible} 篇 · 已筛选` : `${cards.length} 篇`;
      }
      if (emptyEl) emptyEl.hidden = visible > 0;
      if (clearBtn) clearBtn.classList.toggle('hidden', selected.length === 0);

      // 让筛选状态可以分享、刷新后保留
      const query = selected.length > 0 ? `?tags=${encodeURIComponent(selected.join(','))}` : '';
      history.replaceState(null, '', `${location.pathname}${query}`);
    }

    // 支持从链接恢复筛选，例如 /?tags=随笔
    const initialTags = new URLSearchParams(location.search).get('tags')?.split(',') ?? [];
    for (const box of boxes) box.checked = initialTags.includes(box.value);
    for (const box of boxes) box.addEventListener('change', applyFilter);
    clearBtn?.addEventListener('click', () => {
      for (const box of boxes) box.checked = false;
      applyFilter();
    });
    applyFilter();
  </script>
</Base>
