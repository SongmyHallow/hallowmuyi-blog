---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base title="首页">
  <section class="mb-16">
    <h1 class="font-serif text-3xl font-semibold mb-4">你好，我是 muyi。</h1>
    <p class="text-muted dark:text-muted-dark leading-relaxed">
      这里是我的个人角落，记录技术、阅读和一些不成体系的随想。
    </p>
  </section>

  <section>
    <h2 class="font-serif text-xl font-semibold mb-6">最近文章</h2>
    <ul class="space-y-4">
      {posts.map((post) => (
        <li class="group">
          <a href={`/blog/${post.id}`} class="flex items-baseline justify-between gap-4">
            <span class="font-serif group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
              {post.data.title}
            </span>
            <time class="text-sm text-muted dark:text-muted-dark shrink-0 font-mono">
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
    <a href="/blog" class="inline-block mt-8 text-sm text-accent dark:text-accent-dark hover:underline underline-offset-4">
      全部文章 →
    </a>
  </section>
</Base>
