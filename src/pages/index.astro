---
import Base from '../layouts/Base.astro';
import { listPosts } from '../lib/db';
import { monthDay, yearOf } from '../utils/postMeta';

const all = await listPosts();
const posts = all.slice(0, 5);

// EXP 按「今年已发文章数 ÷ 年度目标 12 篇」计算
const year = new Date().getFullYear();
const yearCount = all.filter((p) => yearOf(p.date) === year).length;
const expBlocks = Math.max(1, Math.min(8, Math.round((yearCount / 12) * 8)));
const expPct = Math.min(100, Math.round((yearCount / 12) * 100));

const menu = [
  { name: '开始冒险', note: '文章列表', href: '/blog' },
  { name: '读取存档', note: '归档', href: '/archive' },
  { name: '物品栏', note: '标签', href: '/tags' },
  { name: '制作名单', note: '关于', href: '/about' },
];
---

<Base title="首页">
  {/* 标题画面 */}
  <section class="mb-12 text-center lg:mb-16">
    <p class="font-pixel text-[11px] tracking-[0.3em] text-muted dark:text-muted-dark">
      PLAYER ONE · INSERT COIN
    </p>
    <h1 class="mt-5 inline-flex items-center justify-center font-pixel text-4xl leading-none tracking-widest sm:text-5xl lg:text-6xl">
      MUYI&nbsp;BLOG<span class="ml-3 inline-block h-3 w-3 bg-accent dark:bg-accent-dark lg:h-4 lg:w-4"></span>
    </h1>
    <p class="mt-5 font-pixel text-xs tracking-[0.15em] text-muted dark:text-muted-dark">
      技术随笔 · 读书笔记 · 胡思乱想
    </p>
    <p class="mt-6 font-pixel text-xs tracking-[0.2em] text-muted dark:text-muted-dark">
      PRESS START <span class="px-blink text-accent dark:text-accent-dark">▮</span>
    </p>
  </section>

  <div class="grid gap-6 lg:grid-cols-12 lg:gap-7">
    {/* 角色状态 */}
    <section class="px-card p-5 sm:p-6 lg:col-span-5 lg:p-7">
      <div class="mb-5 flex items-center justify-between font-pixel text-xs text-muted dark:text-muted-dark">
        <span>PLAYER STATUS</span>
        <span>LV.01</span>
      </div>
      <p class="mb-5 font-pixel text-2xl lg:text-3xl">MUYI</p>
      <div class="space-y-2.5 font-pixel text-xs">
        <div class="flex items-center gap-3">
          <span class="w-12 text-muted dark:text-muted-dark">HP</span>
          <span class="tracking-[0.2em] text-accent dark:text-accent-dark">▮▮▮▮▮▮▮</span>
          <span class="tracking-[0.2em] opacity-25">▮</span>
          <span class="ml-auto text-muted dark:text-muted-dark">7/8</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-12 text-muted dark:text-muted-dark">EXP</span>
          <span class="tracking-[0.2em] text-accent dark:text-accent-dark">{'▮'.repeat(expBlocks)}</span>
          <span class="tracking-[0.2em] opacity-25">{'▮'.repeat(8 - expBlocks)}</span>
          <span class="ml-auto text-muted dark:text-muted-dark">{expPct}%</span>
        </div>
        <div class="flex items-center gap-3 pt-1">
          <span class="w-12 text-muted dark:text-muted-dark">CLASS</span>
          <span>写作者</span>
          <span class="ml-auto text-muted dark:text-muted-dark">{year} 已写 {yearCount} 篇</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-12 text-muted dark:text-muted-dark">SAVES</span>
          <span class="tracking-[0.2em]">{'▮'.repeat(Math.min(8, all.length))}{'▯'.repeat(Math.max(0, 8 - all.length))}</span>
          <span class="ml-auto text-muted dark:text-muted-dark">{all.length} 篇存档</span>
        </div>
      </div>
    </section>

    {/* 主菜单 */}
    <section class="px-card p-5 sm:p-6 lg:col-span-7 lg:p-7">
      <h2 class="mb-4 font-pixel text-xs text-muted dark:text-muted-dark">MAIN MENU</h2>
      <ul>
        {menu.map((item) => (
          <li>
            <a href={item.href} class="menu-row">
              <span class="menu-name font-pixel text-2xl lg:text-[28px]">{item.name}</span>
              <span class="menu-note hidden font-pixel text-xs sm:inline">{item.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* 任务日志 */}
    <section class="px-card p-5 sm:p-6 lg:col-span-12 lg:p-7">
      <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 class="font-pixel text-xs text-muted dark:text-muted-dark">QUEST LOG</h2>
        <span class="font-pixel text-xs text-muted dark:text-muted-dark">LATEST {posts.length}</span>
      </div>
      {posts.length > 0 ? (
        <ul class="grid gap-x-10 sm:grid-cols-2">
          {posts.map((post, index) => (
            <li>
              <a href={`/blog/${post.slug}`} class="menu-row group">
                <span class="flex min-w-0 items-baseline gap-3">
                  <span class="font-pixel text-xs text-muted dark:text-muted-dark">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="menu-name truncate">{post.title}</span>
                </span>
                <span class="menu-note shrink-0 font-pixel text-xs">[{monthDay(post.date)}]</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="py-6 font-pixel text-sm text-muted dark:text-muted-dark">NO QUESTS YET — 先去写第一篇。</p>
      )}
      <a href="/blog" class="px-btn mt-5">VIEW ALL QUESTS →</a>
    </section>
  </div>
</Base>
