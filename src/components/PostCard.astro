---
import type { CollectionEntry } from 'astro:content';
import { postMeta, formatDate } from '../utils/postMeta';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { words, minutes } = postMeta(post.body ?? '');
---

<article class="group">
  <a href={`/blog/${post.id}`} class="block">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
      <h2 class="text-lg font-semibold group-hover:text-accent dark:group-hover:text-accent-dark transition-colors leading-snug">
        {post.data.title}
      </h2>
      <time class="text-sm text-muted dark:text-muted-dark shrink-0 font-mono">
        {formatDate(post.data.date)}
      </time>
    </div>
    {post.data.description && (
      <p class="text-sm text-muted dark:text-muted-dark mt-1.5 leading-relaxed">{post.data.description}</p>
    )}
    <div class="flex items-center gap-3 mt-1.5 text-xs text-muted dark:text-muted-dark">
      {post.data.tags.length > 0 && (
        <span class="flex gap-2">
          {post.data.tags.map((t) => (
            <span class="text-accent dark:text-accent-dark">#{t}</span>
          ))}
        </span>
      )}
      <span class="font-mono">{words} 字 · {minutes} 分钟</span>
    </div>
  </a>
</article>
