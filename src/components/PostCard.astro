---
import type { CollectionEntry } from 'astro:content';
import { postMeta, formatDate } from '../utils/postMeta';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { words, minutes } = postMeta(post.body ?? '');
---

<article class="px-card p-5 hover:border-accent dark:hover:border-accent-dark">
  <a href={`/blog/${post.id}`} class="block">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
      <h2 class="font-pixel text-2xl leading-snug">
        {post.data.title}
      </h2>
      <time class="font-pixel text-xs text-muted dark:text-muted-dark shrink-0">
        [{formatDate(post.data.date)}]
      </time>
    </div>
    {post.data.description && (
      <p class="text-sm text-muted dark:text-muted-dark mt-2 leading-relaxed">{post.data.description}</p>
    )}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-3">
      {post.data.tags.map((t) => (
        <span class="px-tag">#{t}</span>
      ))}
      <span class="font-pixel text-xs text-muted dark:text-muted-dark ml-auto">{words} 字 · {minutes} 分钟</span>
    </div>
  </a>
</article>
