---
import type { Post } from '../lib/types';
import { postMeta, formatDate } from '../utils/postMeta';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { words, minutes } = postMeta(post.body ?? '');
---

<article class="px-card p-5 transition-colors hover:border-accent sm:p-6 dark:hover:border-accent-dark">
  <a href={`/blog/${post.slug}`} class="block">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-pixel text-xl leading-snug sm:text-2xl">{post.title}</h2>
      <time class="shrink-0 font-pixel text-xs text-muted dark:text-muted-dark">
        [{formatDate(post.date)}]
      </time>
    </div>
    {post.description && (
      <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted dark:text-muted-dark">
        {post.description}
      </p>
    )}
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
      {post.tags.map((tag) => (
        <span class="px-tag">#{tag}</span>
      ))}
      <span class="ml-auto font-pixel text-xs text-muted dark:text-muted-dark">{words} 字 · {minutes} 分钟</span>
    </div>
  </a>
</article>
